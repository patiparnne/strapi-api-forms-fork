{
  "kind": "collectionType",
  "collectionName": "notification",
  "info": {
    "singularName": "notification",
    "pluralName": "notifications",
    "displayName": "Form | Notification"
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": true
    }
  },
  "options": {
    "draftAndPublish": false,
    "privateAttributes": ["createdAt", "updatedAt"]
  },
  "attributes": {
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "text",
      "default": ""
    },
    "enabled": {
      "type": "boolean"
    },
    "identifier": {
      "type": "enumeration",
      "enum": ["notification", "confirmation"],
      "default": "notification"
    },
    "service": {
      "type": "string",
      "default": "emailService"
    },
    "form": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::api-forms.form",
      "inversedBy": "notifications"
    },
    "webhookEnabled": {
      "type": "boolean",
      "default": false
    },
    "webhookUrl": {
      "type": "string"
    },
    "webhookMethod": {
      "type": "enumeration",
      "enum": ["GET", "POST"],
      "default": "POST"
    },
    "webhookHeaders": {
      "type": "text",
      "default": "{\"Content-Type\": \"application/json\"}"
    },
    "webhookBody": {
      "type": "text",
      "default": "{\"message\": \"Form submitted\", \"data\": \"{{submission}}\"}"
    }
  }
}
